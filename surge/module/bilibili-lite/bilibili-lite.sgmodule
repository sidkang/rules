#!name=Bilibili Lite
#!desc=2026.10.08.3 | 开屏去广告、搜索清理、底栏精简、播放器下方广告清理。轻量详情处理，脚本均由本仓库提供。

# Published module: Surge downloads and caches the response script.
# Optional diagnostics default to off; the private CLI tool remains in the local skill.
# Disable BiliUniverse ADBlock and Enhanced before enabling this module.

[Script]
SID-Bili-Splash = type=http-response,pattern=^https:\/\/(app\.bilibili\.com|app\.biliapi\.net)\/x\/v2\/splash\/(show|list|brand\/list|event\/list2)(\?|$),requires-body=true,max-size=262144,script-path=https://cdn.jsdelivr.net/gh/sidkang/rules@main/surge/module/bilibili-lite/response.js,timeout=5
SID-Bili-Search = type=http-response,pattern=^https:\/\/(app\.bilibili\.com|app\.biliapi\.net)\/x\/v2\/search\/(square|defaultwords)(\?|$),requires-body=true,max-size=262144,script-path=https://cdn.jsdelivr.net/gh/sidkang/rules@main/surge/module/bilibili-lite/response.js,timeout=5
SID-Bili-Navigation = type=http-response,pattern=^https:\/\/(app\.bilibili\.com|app\.biliapi\.net)\/x\/resource\/show\/tab\/v2(\?|$),requires-body=true,max-size=262144,script-path=https://cdn.jsdelivr.net/gh/sidkang/rules@main/surge/module/bilibili-lite/response.js,timeout=5

# Video detail ads: lightweight wire-field filtering; source and licenses in this directory.
# Only View / AIRelateAsync; excludes PlayURL, PlayView, PlayerUnite and Workers redirects.
SID-Bili-VideoDetail = type=http-response,pattern=^https:\/\/(app\.bilibili\.com|app\.biliapi\.net|grpc\.biliapi\.net)\/bilibili\.app\.(view\.v1\.View\/View|viewunite\.v1\.View\/(View|AIRelateAsync))$,requires-body=true,binary-body-mode=true,engine=jsc,max-size=262144,script-path=https://cdn.jsdelivr.net/gh/sidkang/rules@main/surge/module/bilibili-lite/video-detail-fast.js,timeout=5

# Only the default-search-word gRPC endpoint; never reject View or playback APIs.
[URL Rewrite]
^https:\/\/(app\.bilibili\.com|app\.biliapi\.net)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords(\?|$) - reject

[MITM]
hostname = %APPEND% app.bilibili.com, app.biliapi.net, grpc.biliapi.net
