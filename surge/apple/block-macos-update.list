# Enable only when intentionally blocking update services, not just major macOS upgrades.
# configuration.apple.com also serves Rosetta 2 updates; updates-http.cdn-apple.com
# also serves iOS/iPadOS carrier settings. Do not apply to all devices by file name alone.
DOMAIN-SUFFIX,mesu.apple.com
DOMAIN-SUFFIX,gdmf.apple.com
DOMAIN-SUFFIX,updates-http.cdn-apple.com
DOMAIN-SUFFIX,xp.apple.com
DOMAIN-SUFFIX,swdist.apple.com
DOMAIN-SUFFIX,swscan.apple.com
DOMAIN-SUFFIX,configuration.apple.com
DOMAIN-SUFFIX,swcdn.apple.com
DOMAIN-SUFFIX,swquery.apple.com
DOMAIN-SUFFIX,swdownload.apple.com
